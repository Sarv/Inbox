{
  "name": "@sarvinbox/site",
  "version": "0.0.0",
  "private": true,
  "description": "Download page for Sarv Inbox, hosted on GitHub Pages — detects the visitor's device and offers the matching installer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src test scripts vite.config.js --ext .js,.mjs",
    "sync-theme": "node scripts/sync-theme.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "bowser": "^2.14.1"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^6.1.2",
    "postcss-value-parser": "^4.2.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
