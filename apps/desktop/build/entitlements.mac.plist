<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 JITs JavaScript; the hardened runtime blocks writable-executable
       memory unless these three are granted. Without them the app crashes on
       launch once it is signed with hardenedRuntime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- better-sqlite3-multiple-ciphers loads as an unpacked .node outside the
       app bundle's signed library set; library validation would reject it. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- IMAP/SMTP connections out, and the loopback listener used for OAuth
       redirect capture. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- Saving and attaching files the user picks in a native dialog. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
