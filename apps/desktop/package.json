{
  "name": "@sarvinbox/desktop",
  "version": "1.1.1",
  "productName": "Sarv Inbox",
  "description": "Sarv Inbox — AI-powered email client by Sarv",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Sarv",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node ../../scripts/native-abi.mjs electron && pnpm --filter @sarvinbox/core build && pnpm --filter @sarvinbox/storage-node build && vite </dev/null",
    "build": "tsc && vite build && electron-builder",
    "build:electron": "electron-builder",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "node ../../scripts/native-abi.mjs node && vitest run",
    "test:coverage": "node ../../scripts/native-abi.mjs node && vitest run --coverage",
    "lint": "eslint electron src test vite --ext .ts,.tsx",
    "check:renderer-bundle": "vite build --config vite/check-renderer-bundle.config.ts",
    "clean": "rm -rf dist dist-electron node_modules/.vite && node ../../scripts/clean-stale-js.mjs src electron",
    "electron:dev": "node ../../scripts/native-abi.mjs electron && pnpm clean && pnpm --filter @sarvinbox/core build && pnpm --filter @sarvinbox/storage-node build && vite </dev/null",
    "electron:build": "pnpm clean && vite build && electron-builder",
    "test:unit": "node ../../scripts/native-abi.mjs node && vitest run test/unit",
    "test:integration": "node ../../scripts/native-abi.mjs node && vitest run test/integration"
  },
  "dependencies": {
    "@sarv-in/email-chat-view": "^0.2.2",
    "@sarv-in/email-spam-scan": "file:../../../email-spam-scan",
    "@sarvinbox/core": "workspace:*",
    "@sarvinbox/storage-node": "workspace:*",
    "@sentry/electron": "^7.15.0",
    "@tiptap/extension-color": "^3.15.1",
    "@tiptap/extension-image": "^3.15.1",
    "@tiptap/extension-link": "^3.15.1",
    "@tiptap/extension-placeholder": "^3.15.1",
    "@tiptap/extension-text-align": "^3.15.1",
    "@tiptap/extension-text-style": "^3.15.1",
    "@tiptap/extension-underline": "^3.15.1",
    "@tiptap/pm": "^3.15.1",
    "@tiptap/react": "^3.15.1",
    "@tiptap/starter-kit": "^3.15.1",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^12.0.0",
    "chrono-node": "^2.10.0",
    "date-fns": "^3.2.0",
    "dompurify": "^3.1.7",
    "email-addresses": "^5.0.0",
    "html-to-text": "^10.0.0",
    "ical.js": "^2.2.1",
    "iconv-lite": "^0.7.0",
    "imapflow": "^1.4.2",
    "jsonrepair": "3.15.0",
    "libmime": "^5.3.7",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^0.309.0",
    "mailparser": "^3.6.5",
    "markdown-it": "^14.3.0",
    "nodemailer": "^7.0.12",
    "p-limit": "^3.1.0",
    "p-map": "^4.0.0",
    "pino": "^10.3.1",
    "pretty-bytes": "^7.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sanitize-filename": "^1.6.4",
    "tldts": "^7.4.10",
    "turndown": "^7.1.2",
    "uniqolor": "^1.1.1",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@types/html-to-text": "^9.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "happy-dom": "^20.11.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.sarv.sarvinbox",
    "productName": "Sarv Inbox",
    "electronVersion": "43.2.0",
    "afterPack": "./build/afterPack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "dist-electron/db-compact.worker.js"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 190,
          "y": 160
        },
        {
          "x": 470,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "zip"
      ],
      "category": "Office"
    }
  }
}
