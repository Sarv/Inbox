{
  "name": "@sarvinbox/desktop",
  "version": "1.4.3",
  "productName": "Sarv Inbox",
  "desktopName": "com.sarv.sarvinbox.desktop",
  "description": "Sarv Inbox — AI-powered email client by Sarv",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Sarv",
  "homepage": "https://github.com/Sarv/Inbox",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sarv/Inbox.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node ../../scripts/native-abi.mjs electron && node ../../scripts/build-keychain-helper.mjs && pnpm --filter @sarvinbox/core build && pnpm --filter @sarvinbox/storage-node build && vite </dev/null",
    "build": "tsc && vite build && node scripts/prefetch-default-extensions.mjs && electron-builder",
    "prefetch:extensions": "node scripts/prefetch-default-extensions.mjs",
    "gen:dev-icon": "electron scripts/gen-dev-icon.mjs",
    "build:electron": "electron-builder",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "node ../../scripts/native-abi.mjs node && vitest run",
    "test:coverage": "node ../../scripts/native-abi.mjs node && vitest run --coverage",
    "lint": "eslint electron src test vite --ext .ts,.tsx",
    "check:renderer-bundle": "vite build --config vite/check-renderer-bundle.config.ts",
    "clean": "rm -rf dist dist-electron node_modules/.vite && node ../../scripts/clean-stale-js.mjs src electron",
    "electron:dev": "node ../../scripts/native-abi.mjs electron && node ../../scripts/build-keychain-helper.mjs && pnpm clean && pnpm --filter @sarvinbox/core build && pnpm --filter @sarvinbox/storage-node build && vite </dev/null",
    "electron:build": "pnpm clean && vite build && electron-builder",
    "test:unit": "node ../../scripts/native-abi.mjs node && vitest run test/unit",
    "test:integration": "node ../../scripts/native-abi.mjs node && vitest run test/integration"
  },
  "dependencies": {
    "@sarv-in/email-chat-view": "^0.2.7",
    "@sarv-in/mailguard": "^0.4.3",
    "@sarvinbox/core": "workspace:*",
    "@sarvinbox/storage-node": "workspace:*",
    "@sentry/electron": "^7.20.0",
    "@thednp/dommatrix": "^3.1.2",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^12.0.0",
    "chrono-node": "^2.10.2",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "email-addresses": "^5.0.0",
    "fast-xml-parser": "^5.5.6",
    "fflate": "^0.8.3",
    "html-to-text": "^10.0.1",
    "ical.js": "^2.2.1",
    "iconv-lite": "^0.7.3",
    "imapflow": "^2.2.1",
    "jsonrepair": "3.15.0",
    "libmime": "^5.4.6",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^0.577.0",
    "mailparser": "^3.9.33",
    "markdown-it": "^15.0.3",
    "nodemailer": "^10.0.14",
    "p-limit": "^7.3.3",
    "p-map": "^7.0.8",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "postcss": "^8.5.28",
    "postcss-value-parser": "^4.2.0",
    "pretty-bytes": "^7.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-filename": "^1.6.4",
    "tar": "^7.5.22",
    "tldts": "^7.4.15",
    "turndown": "^7.2.4",
    "uniqolor": "^1.1.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@electron/rebuild": "^4.2.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/culori": "^4.0.1",
    "@types/html-to-text": "^9.0.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "happy-dom": "^20.14.5",
    "parse5": "^8.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.0",
    "vite": "^8.3.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.sarv.sarvinbox",
    "productName": "Sarv Inbox",
    "electronVersion": "43.2.0",
    "publish": [
      {
        "provider": "github",
        "owner": "Sarv",
        "repo": "Inbox"
      }
    ],
    "beforeBuild": "./build/beforeBuild.js",
    "afterPack": "./build/afterPack.js",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/!(better-sqlite3|bindings|file-uri-to-path){,/**}",
      "!dist/icon-dev.png",
      "!**/build/Release/obj/**",
      "!**/build/Release/obj.target/**",
      "!**/build/Release/.deps/**",
      "!**/build/deps/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "dist-electron/*.worker.js"
    ],
    "extraResources": [
      {
        "from": "extensions.config.json",
        "to": "extensions.config.json"
      },
      {
        "from": "build/default-extensions",
        "to": "default-extensions",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../extensions/clamav-scan",
        "to": "optional-extensions/clamav-scan",
        "filter": [
          "sarvinbox-extension.json",
          "index.js",
          "icon.svg",
          "panel/**/*",
          "README.md"
        ]
      }
    ],
    "mac": {
      "artifactName": "sarv-inbox-${version}-mac-${arch}.${ext}",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "protocols": [
        {
          "name": "Sarv Inbox email",
          "schemes": [
            "mailto"
          ],
          "role": "Editor"
        },
        {
          "name": "Sarv Inbox calendar",
          "schemes": [
            "webcal",
            "webcals"
          ],
          "role": "Editor"
        }
      ],
      "fileAssociations": [
        {
          "ext": "ics",
          "name": "iCalendar calendar",
          "role": "Editor",
          "rank": "Alternate"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "sarv-inbox-${version}-mac-arm64-amd64.${ext}",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 190,
          "y": 160
        },
        {
          "x": 470,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "executableName": "sarv-inbox",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "category": "Office;Network;Email",
      "synopsis": "Privacy-first email client with AI-powered features",
      "description": "Sarv Inbox is a source-available IMAP email client with encrypted local mail storage, optional AI providers and optional user-authorized ClamAV scans.",
      "maintainer": "Sarv Webs Private Limited <support@sarv.com>",
      "artifactName": "sarv-inbox-${version}-${arch}.${ext}",
      "mimeTypes": [
        "x-scheme-handler/mailto",
        "x-scheme-handler/webcal",
        "x-scheme-handler/webcals",
        "text/calendar"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "com.sarv.sarvinbox",
          "MimeType": "x-scheme-handler/mailto;x-scheme-handler/webcal;x-scheme-handler/webcals;text/calendar;"
        }
      },
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        },
        {
          "target": "rpm"
        }
      ]
    },
    "deb": {
      "packageName": "sarv-inbox"
    },
    "rpm": {
      "packageName": "sarv-inbox"
    },
    "nsis": {
      "include": "build/default-apps.nsh",
      "artifactName": "Sarv-Inbox-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sarv Inbox",
      "uninstallDisplayName": "Sarv Inbox"
    }
  }
}
