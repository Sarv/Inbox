# Normalize line endings; let git auto-detect text vs binary
* text=auto

# Binary assets — never diff/merge as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.db   binary

# OpenPGP test fixtures: signatures cover exact bytes, CRLF included, so git
# must never rewrite their line endings.
packages/core/test/unit/pgp/fixtures/** -text

# Generated — collapse in diffs / exclude from language stats
pnpm-lock.yaml linguist-generated=true
