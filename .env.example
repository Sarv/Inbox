# Sarv Inbox — environment configuration (example)
#
# Copy to `.env` and fill in your own values. `.env` is gitignored and must
# NEVER be committed. All values are optional: OAuth providers you don't
# configure are simply hidden in the UI.
#
# These override the built-in defaults in packages/core/src/oauth/providers.ts
# at runtime, so you can rotate credentials without touching source.

# ── Google / Gmail OAuth ──────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Desktop).
# Google's token endpoint requires both id and secret even with PKCE.
# See OAUTH_SETUP.md.
SARVINBOX_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SARVINBOX_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Microsoft / Outlook OAuth (optional) ──────────────────────────────
SARVINBOX_MICROSOFT_CLIENT_ID=

# ── Yahoo Mail OAuth (optional) ───────────────────────────────────────
SARVINBOX_YAHOO_CLIENT_ID=

# ── Sarv OAuth + LLM (optional) ───────────────────────────────────────
# Public PKCE client registered in your Sarv OAuth dashboard. See
# SARV_OAUTH_SETUP.md. Base URLs default to production; override for dev.
SARVINBOX_SARV_CLIENT_ID=
SARVINBOX_SARV_CLIENT_SECRET=
SARVINBOX_SARV_OAUTH_BASE_URL=
SARVINBOX_SARV_API_BASE_URL=
SARVINBOX_SARV_EDGE_BASE_URL=

# ── Sentry crash/error reporting (optional) ───────────────────────────
# DSN from your Sentry project (Settings → Projects → Client Keys). Public by
# design — safe to embed in the shipped client. Baked into the main + renderer
# bundles at build time; left blank, Sentry stays completely inert.
SARVINBOX_SENTRY_DSN=

# Source-map upload (readable renderer stack traces). Only used at BUILD time,
# read directly by @sentry/vite-plugin (NOT the SARVINBOX_ prefix). The auth
# token is a SECRET — never commit it. Without the token, source-map upload is
# skipped and everything else still works.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── macOS release signing / notarization (maintainers only) ───────────
# Read by scripts/build-dmg.sh (a local signed DMG), NOT by the app. Release
# builds sign in CI from repository secrets instead - see docs/RELEASING.md.
# All three are required to produce a signed, notarized build; none is a
# secret in itself (the .p12 password lives in the login Keychain).
SARV_P12_PATH=
P12_KC_SERVICE=
NOTARY_PROFILE=
