{
  "name": "@sarvinbox/storage-node",
  "version": "0.1.6",
  "description": "Node.js SQLite storage implementation for Sarv Inbox",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Sarv",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "node ../../scripts/native-abi.mjs node && vitest run",
    "test:coverage": "node ../../scripts/native-abi.mjs node && vitest run --coverage",
    "test:watch": "node ../../scripts/native-abi.mjs node && vitest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:unit": "node ../../scripts/native-abi.mjs node && vitest run test/unit",
    "test:integration": "node ../../scripts/native-abi.mjs node && vitest run test/integration"
  },
  "dependencies": {
    "@sarvinbox/core": "workspace:*",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
