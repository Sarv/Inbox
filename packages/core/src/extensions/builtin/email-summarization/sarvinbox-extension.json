{
  "id": "email-summarization",
  "name": "Email Summarization",
  "version": "1.0.0",
  "description": "Generates AI-powered summaries for emails and email threads",
  "author": "Sarv Inbox Team",
  "main": "./index.js",
  "engines": {
    "sarvinbox": "^1.0.0"
  },
  "permissions": [
    "email:read",
    "ai:use",
    "storage:local"
  ],
  "builtin": true,
  "contributes": {
    "workflows": [
      {
        "id": "summarize-email",
        "name": "Email Summarization",
        "description": "Generates summaries for emails and threads",
        "priority": 30
      }
    ],
    "settings": [
      {
        "key": "email-summarization.enabled",
        "type": "boolean",
        "default": true,
        "description": "Enable email summarization"
      },
      {
        "key": "email-summarization.autoSummarize",
        "type": "boolean",
        "default": false,
        "description": "Automatically summarize long emails"
      },
      {
        "key": "email-summarization.minLength",
        "type": "number",
        "default": 500,
        "description": "Minimum email length (chars) to auto-summarize"
      }
    ]
  }
}
