{
  "id": "ai-categorization",
  "name": "AI Email Categorization",
  "version": "1.0.0",
  "description": "Automatically categorize emails using AI (important, spam, reminders, needs response, etc.)",
  "author": "Sarv Inbox",
  "main": "./index.js",
  "engines": {
    "sarvinbox": "^1.0.0"
  },
  "permissions": [
    "email:read",
    "email:label",
    "ai:use",
    "storage:local",
    "settings:read"
  ],
  "contributes": {
    "workflows": [
      {
        "id": "categorize",
        "name": "AI Categorization",
        "description": "Categorize emails as important, spam, reminders, etc.",
        "priority": 50,
        "requiresAI": true,
        "enabledByDefault": true
      }
    ],
    "settings": [
      {
        "key": "ai-categorization.batchSize",
        "type": "number",
        "default": 20,
        "description": "Number of emails to process in a single AI batch",
        "minimum": 1,
        "maximum": 50
      },
      {
        "key": "ai-categorization.confidenceThreshold",
        "type": "number",
        "default": 0.5,
        "description": "Minimum confidence score to apply category",
        "minimum": 0,
        "maximum": 1
      }
    ],
    "events": [
      "email:synced"
    ]
  },
  "builtin": true,
  "keywords": [
    "ai",
    "categorization",
    "spam",
    "important",
    "classification"
  ]
}
