{
  "id": "signature-detection",
  "name": "Signature Detection",
  "version": "1.0.0",
  "description": "Detects and extracts email signatures using AI and common patterns",
  "author": "Sarv Inbox Team",
  "main": "./index.js",
  "engines": {
    "sarvinbox": "^1.0.0"
  },
  "permissions": [
    "email:read",
    "ai:use",
    "storage:local"
  ],
  "builtin": true,
  "contributes": {
    "workflows": [
      {
        "id": "detect-signature",
        "name": "Signature Detection",
        "description": "Detects signatures in email bodies",
        "priority": 20
      }
    ],
    "settings": [
      {
        "key": "signature-detection.enabled",
        "type": "boolean",
        "default": true,
        "description": "Enable signature detection"
      }
    ]
  }
}
