{
  "name": "@sarvinbox/core",
  "version": "0.1.6",
  "description": "Platform-agnostic business logic for Sarv Inbox",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Sarv",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./extension-sdk": {
      "types": "./dist/extension-sdk.d.ts",
      "import": "./dist/extension-sdk.mjs",
      "require": "./dist/extension-sdk.js"
    },
    "./extension-sdk-text": {
      "types": "./dist/extension-sdk-text.d.ts",
      "import": "./dist/extension-sdk-text.mjs",
      "require": "./dist/extension-sdk-text.js"
    },
    "./pgp": {
      "types": "./dist/pgp.d.ts",
      "import": "./dist/pgp.mjs",
      "require": "./dist/pgp.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src test --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@sarv-in/mailguard": "^0.4.3",
    "@zone-eu/mailsplit": "^5.4.19",
    "chardet": "^2.2.0",
    "date-fns": "^4.4.0",
    "email-addresses": "^5.0.0",
    "email-reply-parser": "^2.3.9",
    "free-email-domains": "^1.12.16",
    "html-to-text": "^10.0.1",
    "iconv-lite": "^0.7.3",
    "imapflow": "^2.2.1",
    "ipaddr.js": "^2.2.0",
    "libmime": "^5.4.6",
    "libphonenumber-js": "^1.13.14",
    "libqp": "^2.1.1",
    "lru-cache": "^7.18.3",
    "mailparser": "^3.9.33",
    "nodemailer": "^10.0.10",
    "openpgp": "^6.3.2",
    "p-retry": "^8.0.1",
    "sanitize-filename": "^1.6.4",
    "sanitize-html": "^2.18.0",
    "tldts": "^7.4.15",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/libmime": "^5.3.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.4",
    "tsup": "^8.0.1",
    "typescript": "^6.0.0",
    "vitest": "^5.0.2"
  }
}
